+func pathIdentity(t *testing.T, path string) (uint64, time.Time) {
+	t.Helper()
+	fi, err := os.Stat(path)
+	require.NoError(t, err)
+	st, ok := fi.Sys().(*syscall.Stat_t)
+	require.True(t, ok)
+	return st.Ino, fi.ModTime()
+}
