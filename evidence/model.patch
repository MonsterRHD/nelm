++func (m *Manager) buildLocked(ctx context.Context, txn *dependencyTxn) error {
+ 	c, err := m.loadChartDir(ctx)
+ 	if err != nil {
+ 		return err
+ 	}
+ 
+-	// If a lock file is found, run a build from that. Otherwise, just do
+-	// an update.
+ 	lock := c.Lock
+ 	if lock == nil {
+-		return m.Update(ctx)
++		return m.updateLocked(ctx, txn, c)
+ 	}
