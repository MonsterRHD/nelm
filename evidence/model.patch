+ 		if err := m.UpdateRepositories(ctx); err != nil {
+ 			return err
+ 		}
+ 	}
+ 
+-	// Now we need to fetch every package here into charts/
+-	return m.downloadAll(ctx, lock.Dependencies)
+-}
++	prepared, err := txn.prepareCandidate(ctx, lock.Dependencies)
++	if err != nil {
++		return err
++	}
